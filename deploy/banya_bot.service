[Unit]
Description=Banya bot Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=banyabot
WorkingDirectory=/opt/banyabot
EnvironmentFile=/etc/banyabot/env
ExecStart=/usr/local/bin/banyabot
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
